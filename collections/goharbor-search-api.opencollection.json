{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harbor artifacts search API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search projects and repositories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/api/v2.0/search",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search projects and repositories"
        }
      ]
    }
  ],
  "bundled": true
}